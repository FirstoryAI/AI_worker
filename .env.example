OPENAI_API_KEY=sk-...

# LangSmith 트레이싱 (smith.langchain.com → Settings → API Keys)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=firstory-pipeline

# 텍스트 모델 등급 → 실제 모델 ID  (uv run python -m firstory.models 로 확인)
MODEL_LIGHT=gpt-5.4-mini
MODEL_MAIN=gpt-5.5

# 이미지
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=low           # low | medium | high
IMAGE_SIZE=1024x1024
IMAGE_CONCURRENCY=3

# 결과물 저장소 (서버). local: FIRSTORY_OUTPUT_ROOT 폴더, s3: Spring과 같은 버킷
# FIRSTORY_STORAGE=s3
# FIRSTORY_S3_BUCKET=your-bucket
# FIRSTORY_S3_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
